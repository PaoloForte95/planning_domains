(define (domain base_domain_htn)
	(:requirements :negative-preconditions :typing :hierarchy :universal-preconditions :method-preconditions)
	(:types
	)
	(:predicates
		(in ?arg0 - material ?arg1 - vehicle)
		(at ?arg0 - locatable ?arg1 - location)
		(free ?arg0 - location)
		(on ?arg0 - material ?arg1 - material ?arg2 - location)
	)

	(:task move_pile
		:parameters (?m - material ?l - location)
	)

	(:task stack_pile
		:parameters (?m1 ?m2 - material ?l - location)
	)

	(:task go_to
		:parameters (?v - vehicle ?l - location)
	)

	(:task pick
		:parameters (?v - vehicle ?l - location ?m - material)
	)

	(:task place
		:parameters (?v - vehicle ?l - location ?m - material)
	)

	(:method m_move_pile_ordering_0
		:parameters (?l1 - location ?l2 - location ?m - material ?v - vehicle)
		:task (move_pile ?m ?l2)
		:subtasks (and
		 (task0 (go_to ?v ?l1))
		 (task1 (pick ?v ?l1 ?m))
		 (task2 (go_to ?v ?l2))
		 (task3 (place ?v ?l2 ?m))
		)
		:ordering (and
			(< task0 task1)
			(< task1 task2)
			(< task2 task3)
		)
	)

	(:method m_stack_pile_ordering_0
		:parameters (?l1 ?l2 ?l3 - location ?m1 ?m2 - material ?v - vehicle)
		:task (stack_pile ?m1 ?m2 ?l3)
		:subtasks (and
		 (task0 (go_to ?v ?l1))
		 (task1 (pick ?v ?l1 ?m2))
		 (task2 (go_to ?v ?l3))
		 (task3 (place ?v ?l3 ?m2))
		 (task4 (go_to ?v ?l2))
		 (task5 (pick ?v ?l2 ?m1))
		 (task6 (go_to ?v ?l3))
		 (task7 (place ?v ?l3 ?m1))
		)
		:ordering (and
			(< task0 task1)
			(< task1 task2)
			(< task2 task3)
			(< task3 task4)
			(< task4 task5)
			(< task5 task6)
			(< task6 task7)
		)
	)



	(:method m_place_ordering_0
		:parameters (?l - location ?m - material ?v - vehicle)
		:task (place ?v ?l ?m)
		:subtasks (and
		 (task0 (dump ?v ?l ?m))
		)
	)

	(:method m_place_ordering_1
		:parameters (?l - location ?m1 - material ?m2 - material ?v - vehicle)
		:task (place ?v ?l ?m1)
		:subtasks (and
		 (task0 (stack ?v ?l ?m1 ?m2))
		)
	)

	(:method m_pick_ordering_0
		:parameters (?l - location ?m - material ?v - vehicle)
		:task (pick ?v ?l ?m)
		:subtasks (and
		 (task0 (load ?v ?l ?m))
		)
	)

	(:method m_pick_ordering_1
		:parameters (?l - location ?m1 - material ?m2 - material ?v - vehicle)
		:task (pick ?v ?l ?m1)
		:subtasks (and
		 (task0 (unstack ?v ?l ?m1 ?m2))
		)
	)

	(:method m_pick_ordering_2
		:parameters (?l - location ?m - material ?v - vehicle)
		:task (pick ?v ?l ?m)
		:subtasks (and
		 (task0 (push ?v ?l ?m))
		)
	)

	(:method m_i_am_there_ordering_0
		:parameters (?l - location ?v - vehicle)
		:task (go_to ?v ?l)
		:subtasks (and
		 (task0 (noop ?v ?l))
		)
	)

	(:method m_drive_to_ordering_0
		:parameters (?l1 - location ?l2 - location ?v - vehicle)
		:task (go_to ?v ?l2)
		:subtasks (and
		 (task0 (drive ?v ?l1 ?l2))
		)
	)

	(:method m_drive_to_ordering_1
		:parameters (?l1 - location ?l2 - location ?v - vehicle ?m - material)
		:task (go_to ?v ?l2)
		:subtasks (and
		 (task0 (transport ?v ?l1 ?l2 ?m))
		)
	)

	(:method m_drive_to_ordering_2
		:parameters (?l1 - location ?l2 - location ?l3 - location ?v1 - vehicle ?v2 - vehicle)
		:task (go_to ?v1 ?l2)
		:subtasks (and
		(task0 (drive ?v2 ?l2 ?l3))
		(task1 (drive ?v1 ?l1 ?l2))
		)
		:ordering (and
			(< task0 task1)
		)
	)


	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; ACTION ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	
	(:action drive
		:parameters (?v - vehicle ?l1 - location ?l2 - location)
		:precondition 
			(and
				(at ?v ?l1)
				(free ?l2)
				(forall (?m - material)
						(not (in ?m ?v))
				)
				
			)
		:effect
			(and
				(not (at ?v ?l1))
				(at ?v ?l2)
				(free ?l1)
				(not (free ?l2))
			)
	)

	(:action transport
		:parameters (?v - vehicle ?l1 - location ?l2 - location ?m - material)
		:precondition 
			(and
				(at ?v ?l1)
				(free ?l2)
				(in ?m ?v)
			)
		:effect
			(and
				(not (at ?v ?l1))
				(at ?v ?l2)
				(free ?l1)
				(not (free ?l2))
			)
	)

	(:action noop
		:parameters (?v - vehicle ?l2 - location)
		:precondition 
			(and
				(at ?v ?l2)
			)
		:effect ()
	)

	(:action push
		:parameters (?v - vehicle ?l - location ?m - material)
		:precondition 
			(and
				(at ?v ?l)
				(at ?m ?l)
				(forall (?m2 - material)
						(not (on ?m2 ?m ?l))
				)				
			)
		:effect
			(and
				(in ?m ?v)
				(not (at ?m ?l))
			)
	)

	(:action load
		:parameters (?v - vehicle ?l - location ?m - material)
		:precondition 
			(and
				(at ?v ?l)
				(at ?m ?l)
				(forall (?m2 - material)
						(not (on ?m2 ?m ?l))
				)
			)
		:effect
			(and
				(in ?m ?v)
				(not (at ?m ?l))
			)
	)

	(:action dump
		:parameters (?v - vehicle ?l - location ?m - material)
		:precondition 
			(and
				(at ?v ?l)
				(in ?m ?v)
				(forall (?m2 - material)
					(not (at ?m2 ?l))
				)
			)
		:effect
			(and
				(not (in ?m ?v))
				(at ?m ?l)
			)
	)

	(:action stack
		:parameters (?v - vehicle ?l - location ?m1 - material ?m2 - material)
		:precondition 
			(and
				(at ?v ?l)
				(in ?m1 ?v)
				(at ?m2 ?l)
			)
		:effect
			(and
				(not (in ?m1 ?v))
				(at ?m1 ?l)
				(on ?m1 ?m2 ?l)
			)
	)

	(:action unstack
		:parameters (?v - vehicle ?l - location ?m1 - material ?m2 - material)
		:precondition 
			(and
				(at ?v ?l)
				(at ?m2 ?l)
				(at ?m1 ?l)
				(on ?m1 ?m2 ?l)
				(forall (?m3 - material)
					(not (on ?m3 ?m1 ?l))
				)
			)
		:effect
			(and
				(not (on ?m1 ?m2 ?l))
				(in ?m1 ?v)
				(not (at ?m1 ?l))
			)
	)

)
