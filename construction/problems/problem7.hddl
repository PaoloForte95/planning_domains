(define (problem object_arrangement_problem_multi_stack)
    (:domain domain_htn)
    (:objects
        gravel brick dirt - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 wp5 - location
    )
    (:init
        ; Initial location of the materials
        (at gravel wp1)
        (at brick wp2)
        (at dirt wp5)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
        (free wp5)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile dirt wp4))
            (task1 (stack_pile gravel dirt wp4))
            (task2 (stack_pile brick gravel wp4))
        )
        :ordering (and
            ; Enforce the order: move dirt, stack gravel, then stack brick
            (< task0 task1)
            (< task1 task2)
        )
	)
)
