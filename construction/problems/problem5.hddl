(define (problem object_arrangement_problem_ordered)
    (:domain domain_htn)
    (:objects
        coal cement_block - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 - location
    )
    (:init
        ; Initial location of the materials
        (at coal wp1)
        (at cement_block wp2)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile coal wp3))
            (task1 (move_pile cement_block wp4))
        )
        :ordering (and
            ; Enforce the order: move coal, then cement_block
            (< task0 task1)
        )
	)
)
