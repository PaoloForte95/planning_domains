(define (problem object_arrangement_problem_ordered)
    (:domain domain_htn)
    (:objects
        sand dirt cement - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 wp5 wp6 - location
    )
    (:init
        ; Initial location of the materials
        (at sand wp1)
        (at dirt wp2)
        (at cement wp6)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
        (free wp5)
        (free wp6)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile sand wp3))
            (task1 (move_pile dirt wp4))
            (task2 (move_pile cement wp5))
        )
        :ordering (and
            ; Enforce the order: move sand, then dirt, then cement
            (< task0 task1)
            (< task1 task2)
        )
	)
)
