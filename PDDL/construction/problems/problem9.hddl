(define (problem object_arrangement_problem_double_stack)
    (:domain domain_htn)
    (:objects
        sand dirt cement_block coal - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 wp5 wp6 wp7 - location
    )
    (:init
        ; Initial location of the materials
        (at sand wp1)
        (at dirt wp2)
        (at cement_block wp6)
        (at coal wp7)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
        (free wp5)
        (free wp6)
        (free wp7)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile dirt wp3))
            (task1 (stack_pile sand dirt wp3))
            (task2 (move_pile coal wp4))
            (task3 (stack_pile cement_block coal wp4))
        )
        :ordering (and
            ; Enforce the order: dirt, sand, coal, then cement_block
            (< task0 task1)
            (< task1 task2)
            (< task2 task3)
        )
	)
)