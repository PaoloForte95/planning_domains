(define (problem object_arrangement_problem_stacked_initial)
    (:domain domain_htn)
    (:objects
        sand coal  - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 - location
    )
    (:init
        ; Initial location of the materials, with coal stacked on sand
        (at sand wp1)
        (at coal wp1)
        (on coal sand wp1)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile sand wp3))
            (task1 (move_pile coal wp4))
        )
        :ordering (and
            ; Enforce the order: move sand, then coal
            (< task1 task0)
        )
	)
)