(define (problem object_arrangement_problem_ordered)
    (:domain domain_htn)
    (:objects
        brick dirt - material
        v1 - vehicle
        wp0 wp1 wp2 wp3 wp4 - location
    )
    (:init
        ; Initial location of the materials
        (at brick wp1)
        (at dirt wp2)

        ; Initial location of the vehicle
        (at v1 wp0)

        ; Locations that are initially free
        (free wp1)
        (free wp2)
        (free wp3)
        (free wp4)
    )
    (:htn
		:subtasks (and
            ; Goal tasks to be achieved
            (task0 (move_pile dirt wp4))
            (task1 (move_pile brick wp3))
        )
        :ordering (and
            ; Enforce the order: move dirt before brick
            (< task0 task1)
        )
	)
)
